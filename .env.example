#  2) Rellena los valores en ".env" (ese archivo NO se sube a GitHub)
#  Aquí solo van nombres de variables, nunca valores reales.
# ============================================================

# --- Modelo de lenguaje (LLM) --------------------------------
LLM_API_KEY=
LLM_MODEL=

# --- Modelo de embeddings ------------------------------------
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# --- Base de datos vectorial ---------------------------------
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=ai_act

# --- Aplicación ----------------------------------------------
ENTORNO=desarrollo
LOG_LEVEL=INFO
