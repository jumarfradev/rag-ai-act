# ============================================================
#  Entorno de PRODUCCIÓN — plantilla
#  1) Copia este archivo como ".env.prod"
#  2) Rellena los valores en ".env.prod" (ese archivo NO se sube a GitHub)
#  Aquí solo van nombres de variables, nunca valores reales.
# ============================================================

ENTORNO=produccion
LOG_LEVEL=INFO

# --- Modelo de lenguaje (LLM) --------------------------------
# Clave exclusiva de producción: no la reutilices en desarrollo.
LLM_API_KEY=
LLM_MODEL=

# --- Modelo de embeddings ------------------------------------
# Debe ser el mismo modelo con el que se generó el índice de producción.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# --- Base de datos vectorial ---------------------------------
# Colección propia de producción: solo se regenera a propósito.
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=ai_act_prod
