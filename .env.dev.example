# ============================================================
#  Entorno de DESARROLLO — plantilla
#  1) Copia este archivo como ".env.dev"
#  2) Rellena los valores en ".env.dev" (ese archivo NO se sube a GitHub)
#  Aquí solo van nombres de variables, nunca valores reales.
# ============================================================

ENTORNO=desarrollo
LOG_LEVEL=DEBUG

# --- Modelo de lenguaje (LLM) --------------------------------
# Usa una clave distinta de la de producción y, si el proveedor
# lo permite, con un límite de gasto bajo.
LLM_API_KEY=
LLM_MODEL=

# --- Modelo de embeddings ------------------------------------
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# --- Base de datos vectorial ---------------------------------
# Colección propia de desarrollo: se puede borrar y regenerar sin miedo.
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=ai_act_dev
